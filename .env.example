# Supabase（ローカルでは `pnpm env:local` が .env.local を生成する）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用（サービスロール相当）。クライアントに公開しない。
SUPABASE_SECRET_KEY=

# 取り込み（Sprint 3〜）。サーバー専用。値は画面にも API にも出さない。
# J-Quants API V2 の API キー（J-Quants のダッシュボードで発行。ヘッダー x-api-key で送る）
JQUANTS_API_KEY=
# EDINET API の Subscription-Key（Sprint 8 の有報の取り込みで使う）
EDINET_API_KEY=
# 定期実行（Vercel Cron）の認証。16 文字以上（例: openssl rand -hex 32）。Vercel Cron は Authorization: Bearer <値> を付けて呼ぶ
CRON_SECRET=
